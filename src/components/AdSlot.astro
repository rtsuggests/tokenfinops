---
export interface Props {
  slotType: 'leaderboard' | 'in-content' | 'sidebar' | 'footer';
  slotId?: string;
  adClient?: string;
  className?: string;
}

const {
  slotType,
  slotId = '1234567890',
  adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-XXXXXXXXXXXXXXXX',
  className = '',
} = Astro.props;

const isLiveAdSense = import.meta.env.PROD && Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT);

// Heights strictly reserved to prevent Cumulative Layout Shift (CLS = 0)
const heightMap = {
  leaderboard: 'min-h-[90px] h-[90px] max-w-4xl',
  'in-content': 'min-h-[250px] h-[250px] w-full',
  sidebar: 'min-h-[250px] h-[250px] w-full',
  footer: 'min-h-[120px] h-[120px] w-full',
};

const labelMap = {
  leaderboard: 'Sponsor Leaderboard (728x90)',
  'in-content': 'Sponsored FinOps Partner (Responsive MPU)',
  sidebar: 'Cloud Infrastructure Partner',
  footer: 'Enterprise AI Infrastructure Sponsor',
};
---

<aside
  class={`w-full mx-auto my-6 overflow-hidden rounded-xl border border-slate-800/80 bg-slate-900/40 p-2 text-center transition-all ${heightMap[slotType]} ${className}`}
  aria-label="Advertisement"
>
  {
    isLiveAdSense ? (
      <div class="w-full h-full flex flex-col justify-center items-center overflow-hidden">
        <span class="text-[10px] uppercase tracking-wider text-slate-500 mb-1 block">Sponsored</span>
        <ins
          class="adsbygoogle"
          style="display:block;width:100%;height:100%;"
          data-ad-client={adClient}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
        <script is:inline>
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center rounded-lg border border-dashed border-slate-700/60 bg-slate-950/40 px-4 py-3">
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-medium tracking-wide bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            AdSense Ready
          </span>
          <span class="text-xs font-medium text-slate-400">
            {labelMap[slotType]}
          </span>
        </div>
        <p class="text-[11px] text-slate-500 max-w-md font-mono">
          CLS Guard: Fixed-dimension container (CLS = 0.00). Configured for high-RPM B2B AI developer placements.
        </p>
      </div>
    )
  }
</aside>
