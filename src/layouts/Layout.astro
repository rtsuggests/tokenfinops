---
import SEOHead, { type FaqItem } from '../components/SEOHead.astro';
import modelsData from '../data/models.json';
import workloadsData from '../data/workloads.json';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  faqs?: FaqItem[];
  ogType?: 'website' | 'article';
}

const { title, description, canonicalUrl, faqs, ogType } = Astro.props;

// Top models for header / footer links
const popularModels = modelsData.slice(0, 6);
const popularWorkloads = workloadsData.slice(0, 5);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      faqs={faqs}
      ogType={ogType}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#070A11] text-slate-100 font-sans antialiased selection:bg-emerald-500/30 selection:text-emerald-200">
    <!-- Ambient background gradient grid -->
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.08),rgba(255,255,255,0))]"></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[linear-gradient(to_right,#1f293708_1px,transparent_1px),linear-gradient(to_bottom,#1f293708_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-[#070A11]/85 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-500/20 group-hover:border-emerald-500/50 transition">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-lg tracking-tight text-white group-hover:text-emerald-400 transition">
                Token<span class="text-emerald-400">SpendCalc</span>
              </span>
              <span class="text-[10px] font-mono tracking-wider text-slate-400 -mt-1 uppercase">
                AI Cloud Cost Engine
              </span>
            </div>
          </a>

          <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-slate-800">
            <a href="/" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
              Calculator
            </a>
            <a href="/compare/claude-3-5-sonnet-vs-gpt-4o-api-cost-calculator" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
              Compare Models
            </a>
            <a href="/workloads/rag-pipeline-cost-calculator" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
              B2B Workloads
            </a>
            <a href="/models/claude-3-7-sonnet-pricing-calculator" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
              Pricing Guides
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-mono text-slate-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Live Pricing 2026</span>
          </div>

          <a
            href="#calculator"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition shadow-sm shadow-emerald-500/20"
          >
            Launch Calc
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="w-full">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="mt-20 border-t border-slate-800/80 bg-[#05070D]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <!-- Column 1: Brand & Mission -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
              </div>
              <span class="font-bold text-base text-white">
                Token<span class="text-emerald-400">SpendCalc</span>
              </span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              Enterprise token cost analytics engine for Staff Engineers, FinOps leaders, and AI product managers. Accurately model multi-turn conversational compounding, prompt caching ROI, and context-cliff penalties.
            </p>
            <div class="pt-2 text-xs text-slate-500 font-mono">
              Deterministic 100% Client-Side Engine • Zero Data Storage
            </div>
          </div>

          <!-- Column 2: Popular Comparisons -->
          <div>
            <h3 class="text-xs font-semibold text-slate-200 tracking-wider uppercase mb-3">
              Head-to-Head Comparisons
            </h3>
            <ul class="space-y-2 text-xs">
              <li>
                <a href="/compare/claude-3-5-sonnet-vs-gpt-4o-api-cost-calculator" class="text-slate-400 hover:text-emerald-400 transition">
                  Claude 3.5 Sonnet vs GPT-4o
                </a>
              </li>
              <li>
                <a href="/compare/gpt-4o-vs-gpt-4o-mini-api-cost-calculator" class="text-slate-400 hover:text-emerald-400 transition">
                  GPT-4o vs GPT-4o mini
                </a>
              </li>
              <li>
                <a href="/compare/gemini-2-5-pro-vs-gemini-2-5-flash-api-cost-calculator" class="text-slate-400 hover:text-emerald-400 transition">
                  Gemini 2.5 Pro vs Gemini 2.5 Flash
                </a>
              </li>
              <li>
                <a href="/compare/claude-3-7-sonnet-vs-deepseek-r1-api-cost-calculator" class="text-slate-400 hover:text-emerald-400 transition">
                  Claude 3.7 Sonnet vs DeepSeek-R1
                </a>
              </li>
              <li>
                <a href="/compare/o3-mini-vs-deepseek-r1-api-cost-calculator" class="text-slate-400 hover:text-emerald-400 transition">
                  OpenAI o3-mini vs DeepSeek-R1
                </a>
              </li>
            </ul>
          </div>

          <!-- Column 3: Workloads & Models -->
          <div>
            <h3 class="text-xs font-semibold text-slate-200 tracking-wider uppercase mb-3">
              Architecture Workloads
            </h3>
            <ul class="space-y-2 text-xs">
              {popularWorkloads.map((w) => (
                <li>
                  <a href={`/workloads/${w.slug}-cost-calculator`} class="text-slate-400 hover:text-emerald-400 transition">
                    {w.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 4: Compliance & Legal -->
          <div>
            <h3 class="text-xs font-semibold text-slate-200 tracking-wider uppercase mb-3">
              Trust & Legal
            </h3>
            <ul class="space-y-2 text-xs">
              <li>
                <a href="/about" class="text-slate-400 hover:text-emerald-400 transition">About TokenSpendCalc</a>
              </li>
              <li>
                <a href="/privacy-policy" class="text-slate-400 hover:text-emerald-400 transition">Privacy Policy</a>
              </li>
              <li>
                <a href="/terms" class="text-slate-400 hover:text-emerald-400 transition">Terms of Service</a>
              </li>
              <li>
                <a href="/contact" class="text-slate-400 hover:text-emerald-400 transition">Contact & Ad Inquiries</a>
              </li>
            </ul>
            <div class="mt-4 p-3 rounded-lg bg-slate-900/60 border border-slate-800 text-[11px] text-slate-400">
              Pricing rates based on official provider documentation (Anthropic, OpenAI, Google Cloud, DeepSeek, AWS). Updated daily.
            </div>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <p>© {new Date().getFullYear()} TokenSpendCalc. All rights reserved. Not affiliated with OpenAI, Anthropic, Google, or Microsoft.</p>
          <div class="flex items-center gap-4">
            <a href="/sitemap-index.xml" class="hover:text-slate-200 transition">XML Sitemap</a>
            <span>•</span>
            <a href="/robots.txt" class="hover:text-slate-200 transition">Robots.txt</a>
            <span>•</span>
            <span class="text-emerald-400">99.99% SSG Uptime</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
